# Copy to backend/.env and fill in. Settings are read once at startup.
# Real environment variables take priority over this file. Empty values count as unset.

# ---- Auth ----
# Signs login tokens. Use a long random value, e.g. `openssl rand -hex 32`.
# Changing it logs everyone out.
AUTH_SECRET=
# TOKEN_TTL_MINUTES=60

# ---- Storage ----
# Folder for local data. Default: backend/data
# DATA_DIR=./data
# Database. Default: SQLite in DATA_DIR/app.db. Any SQLAlchemy URL works, e.g. Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/__PROJECT_SLUG__
