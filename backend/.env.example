# Copy to backend/.env and fill in. Settings are read once at startup.
# Real environment variables take priority over this file.

# ---- LLM ----
# Any OpenAI-compatible server. Defaults point at LM Studio on this machine:
# load a model, start the server (Developer tab), and use the model id it lists.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen-local
# LLM_API_KEY=lm-studio          # ignored by LM Studio; needed for hosted servers
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=1

# ---- Auth ----
# Signs login tokens. Use a long random value, e.g. `openssl rand -hex 32`.
# Changing it logs everyone out.
AUTH_SECRET=
# TOKEN_TTL_MINUTES=60

# ---- Storage ----
# Folder for the JSON data files and agent state. Default: backend/data
# DATA_DIR=./data
# WhatsApp session store. Default: data/whatsapp.db (SQLite). Can be a Postgres URL.
# WHATSAPP_DB=postgres://user:password@localhost:5432/landlord
